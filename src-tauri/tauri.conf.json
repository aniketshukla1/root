{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "root",
  "version": "0.1.0",
  "identifier": "com.root.observability",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "root · infrastructure manager",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
